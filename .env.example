VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional: public frontend origin, used for absolute Open Graph URLs at build time.
VITE_PUBLIC_SITE_URL=
# Public Stripe.js key (never sk_*). Hosted Checkout/Portal redirects work without it.
VITE_STRIPE_PUBLISHABLE_KEY=
