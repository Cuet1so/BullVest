{
  "name": "bullvest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:dashboard": "playwright test tests/browser/dashboard.spec.ts",
    "test:academy": "playwright test tests/browser/academy.spec.ts",
    "test:subscription": "playwright test tests/browser/subscription.spec.ts",
    "test:trading": "playwright test tests/browser/trading.spec.ts",
    "test:billing": "deno test --allow-env --config supabase/functions/create-checkout-session/deno.json supabase/functions/_shared/billing_test.ts",
    "test:phase8": "playwright test tests/browser/phase8.spec.ts",
    "test:browser": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "assets:pwa": "node scripts/generate-pwa-assets.mjs"
  },
  "dependencies": {
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "deno": "2.9.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "supabase": "^2.120.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
